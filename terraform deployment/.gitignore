# Terraform state — NEVER commit these
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform.lock.hcl

# Terraform working directory
.terraform/

# Variable files with secrets
terraform.tfvars
*.auto.tfvars

# Lambda build artifacts
.build/

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
