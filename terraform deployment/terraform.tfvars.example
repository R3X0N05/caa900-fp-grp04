# ─── Copy this file to terraform.tfvars and fill in real values ──
# NEVER commit terraform.tfvars to git (it is in .gitignore)

aws_region   = "us-east-1"
project_name = "rexony"
environment  = "prod"

# Stripe — get from https://dashboard.stripe.com/apikeys
stripe_secret_key = "sk_test_REPLACE_ME"

# SES — must match a verified identity in us-east-1
ses_from_email = "noreply@rexony.ca"

# GitHub PAT for Amplify auto-build  (repo:read scope is enough)
amplify_github_token = "ghp_REPLACE_ME"
amplify_repo_url     = "https://github.com/R3X0N05/caa900-fp-grp04"
amplify_branch       = "main"
